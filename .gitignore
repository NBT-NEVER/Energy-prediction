# 纳入实验1.0结果，仅排除包含真实逐采样数据的CSV
!1.0/out/
!1.0/out/**/
!1.0/out/**/*
1.0/out/data/processed_1.0/*.csv
1.0/out/predictions/test_predictions_1.0.csv

# 纳入实验2.0结果，仅排除包含真实逐采样数据的CSV
!2.0/out/
