# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# IDE 与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp
*.bak
tmp/

# 数据、模型和训练产物
data/
model/
out/
output/
*/out/
*/output/
*.pt
*.pth
*.onnx

# 纳入实验1.0结果，仅排除包含真实逐采样数据的CSV
!1.0/out/
!1.0/out/**/
!1.0/out/**/*
1.0/out/data/processed_1.0/*.csv
1.0/out/predictions/test_predictions_1.0.csv

# 纳入实验2.0结果，仅排除包含真实逐采样数据的CSV
!2.0/out/
!2.0/out/**/
!2.0/out/**/*
2.0/out/data/processed_2.0/*.csv
2.0/out/predictions/test_predictions_2.0.csv
# 2.0 需要保留非R1航线筛选结果用于数据追溯
!2.0/out/data/processed_2.0/excluded_routes_2.0.csv

# 纳入实验2.1代码运行后的可复核小型结果，排除逐采样数据和预测大文件
!2.0/out/
!2.0/out/**/
!2.0/out/**/*
2.0/out/data/processed_2.1/*.csv
2.0/out/predictions/*.csv
2.0/out/logs/*.log
2.0/out/data/processed_2.0/*.csv

# 大型或自动生成的数据文件
*.zip
*.7z
*.tar
*.gz

# 纳入实验3.0的全部输出产物；大CSV和NPZ由Git LFS管理
!3.0/out/
!3.0/out/**/
!3.0/out/**/*

# 训练、验证和测试数据仅保留本地，不纳入版本管理
3.0/out/data/processed_3.0/train.csv
3.0/out/data/processed_3.0/val.csv
3.0/out/data/processed_3.0/test.csv

# 纳入实验3.2的图表、统计结果、预测结果和日志，数据目录仅保留本地
!3.2/out/
!3.2/out/**/
!3.2/out/**/*
3.2/out/data/

# 实验4.0追踪图表、报告与评估；逐采样训练数据和权重仅保留本地
!4.0/out/
!4.0/out/**/
!4.0/out/**/*
4.0/out/data/processed_4.0/*.csv
4.0/out/logs/*.log
